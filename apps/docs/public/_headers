# HTML pages — always revalidate. Cloudflare / GitHub Pages compatible.
/
  Cache-Control: public, max-age=0, must-revalidate

/docs
  Cache-Control: public, max-age=0, must-revalidate

/docs/*
  Cache-Control: public, max-age=0, must-revalidate

/composition
  Cache-Control: public, max-age=0, must-revalidate

/composition/*
  Cache-Control: public, max-age=0, must-revalidate

/components
  Cache-Control: public, max-age=0, must-revalidate

/components/*
  Cache-Control: public, max-age=0, must-revalidate

/recipes
  Cache-Control: public, max-age=0, must-revalidate

/recipes/*
  Cache-Control: public, max-age=0, must-revalidate

/showcase/portfolio
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate

/llms.txt
  Cache-Control: public, max-age=0, must-revalidate

# Hashed JS/CSS bundles — content-addressed, safe to cache 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Brand assets
/logo.svg
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/og.svg
  Cache-Control: public, max-age=86400
