{
  "name": "neobrutalism-ui-react",
  "version": "0.2.3",
  "description": "Neo-brutalist React UI primitive library — bold borders, hard shadows, Tailwind CSS v4",
  "author": "Rahmat Ashari <https://github.com/rahmatez>",
  "license": "MIT",
  "homepage": "https://neo-brutalism-react-docs.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahmatez/neo-brutalism-react.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/rahmatez/neo-brutalism-react/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "neo-brutalism",
    "neobrutalism",
    "tailwindcss",
    "tailwind-v4",
    "primitives"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'src/integration/**'",
    "test:integration": "vitest run src/integration",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@radix-ui/react-context-menu": "^2.0.0",
    "@radix-ui/react-hover-card": "^1.0.0",
    "@radix-ui/react-menubar": "^1.0.0",
    "@radix-ui/react-navigation-menu": "^1.0.0",
    "cmdk": "^1.0.0",
    "react-hook-form": "^7.0.0",
    "react-resizable-panels": "^2.0.0",
    "react": ">=18",
    "react-dom": ">=18",
    "recharts": "^2.13.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@radix-ui/react-context-menu": {
      "optional": true
    },
    "@radix-ui/react-hover-card": {
      "optional": true
    },
    "@radix-ui/react-menubar": {
      "optional": true
    },
    "@radix-ui/react-navigation-menu": {
      "optional": true
    },
    "react-resizable-panels": {
      "optional": true
    },
    "cmdk": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@radix-ui/react-context-menu": "^2.3.0",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "cmdk": "^1.1.1",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.57.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "^2.15.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
